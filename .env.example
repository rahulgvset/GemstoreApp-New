DATABASE_URL="file:./dev.db"

# Admin panel credentials. Generate ADMIN_PASSWORD_HASH with:
#   node scripts/hash-password.mjs "your-password"
# IMPORTANT: escape every "$" in the bcrypt hash as "\$" below — Next.js's
# env loader otherwise treats "$2b", "$12", etc. as variable references and
# silently strips them.
ADMIN_EMAIL="admin@celestinestones.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
